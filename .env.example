# Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM Provider: deepseek | openai | anthropic
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Video Provider: seedance | minimax
DEFAULT_VIDEO_PROVIDER=seedance

# Volcengine / Seedance 2.0
ARK_API_KEY=your_volcengine_api_key_here
SEEDANCE_ENDPOINT_ID=your_seedance_endpoint_id_here

# MiniMax H3 视频 (v2, api.minimaxi.com)
MINIMAX_VIDEO_API_KEY=your_minimax_video_api_key_here
MINIMAX_VIDEO_BASE_URL=https://api.minimaxi.com

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8888
DEBUG=true

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# Dify 知识库(可选;留空则知识走内置常量兜底)
# 自部署填自己的 host,如 https://dify.mycorp.com
DIFY_BASE_URL=
DIFY_API_KEY=
# {kind: dataset_id} JSON,kind ∈ prompt_template/cinematography/screenplay_guide/storyboard_guide
DIFY_DATASET_IDS={}

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/drama_agent.db
LANGGRAPH_DB_PATH=./data/langgraph_checkpoints.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
