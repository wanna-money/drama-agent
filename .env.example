# Environment Configuration
# Copy this file to .env and fill in your API keys
#
# 键名须与 config.py 的 Settings 字段一一对应:Settings 配了 extra="ignore",
# 拼错或已废弃的键会被静默丢弃(不报错、也不生效),排查起来只看得到"key 没生效"。

# ── 文本模型 ────────────────────────────────────────────────────────────
# 内置 DeepSeek provider 的凭证(base_url 锁死官方地址,UI 只读)
DRAMA_API_KEY=your_deepseek_api_key_here
# 未按模型名前缀匹配到厂商时的兜底端点(可选)
DRAMA_BASE_URL=
DRAMA_TEXT_MODEL=

# 直连其它厂商(可选;也可在前端「模型管理」页填,存 DB)
KIMI_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=

# ── 视频模型(至少配一个) ───────────────────────────────────────────────
# Volcengine / Seedance
ARK_API_KEY=your_volcengine_api_key_here
SEEDANCE_ENDPOINT_ID=your_seedance_endpoint_id_here
SEEDANCE_2_5_ENDPOINT_ID=

# MiniMax H3 视频 (v2, api.minimaxi.com — 勿与文本模型的 api.minimax.chat 混淆)
MINIMAX_VIDEO_API_KEY=your_minimax_video_api_key_here
MINIMAX_VIDEO_BASE_URL=https://api.minimaxi.com

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8888
DEBUG=true

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
ASSET_STORAGE_BACKEND=local
ASSET_LOCAL_DIR=./data/assets

# 图片/音频参考的送达方式:base64(默认,内联)或 public(传对象存储后给公网 URL)。
# 视频参考不受此开关影响 —— 平台对视频只接受公网 URL。
# 切 public 的用处:base64 有 64MB 请求体上限,Seedance 2.5 的 30 张参考图在
# base64 下发不出去。
REF_DELIVERY_MODE=base64

# Dify 知识库(可选;留空则知识走内置常量兜底)
# 自部署填自己的 host,如 https://dify.mycorp.com
DIFY_BASE_URL=
DIFY_API_KEY=
# {kind: dataset_id} JSON,kind ∈ prompt_template/cinematography/screenplay_guide/storyboard_guide
DIFY_DATASET_IDS={}

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/drama_agent.db
LANGGRAPH_DB_PATH=./data/langgraph_checkpoints.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
